# Configuração da loja Tipiti em produção.
#
# Docker:   cp .env.exemplo .env          (dentro de tipiti/deploy) e edite o .env
# systemd:  sudo cp .env.exemplo /etc/tipiti/tipiti.env   e edite (veja LEIA-ME.md)
#
# O arquivo .env tem segredo (o token do painel): nunca o envie para o git, e-mail ou WhatsApp.
# Formato: VARIAVEL=valor, sem aspas e sem espaços em volta do "=".

# --- Obrigatório -----------------------------------------------------------------------------------

# Token (senha) do painel https://tipiti.com.br/admin. Mínimo de 24 caracteres; a loja NÃO sobe sem ele.
# Gere um token aleatório com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Guarde-o num gerenciador de senhas. Para trocar: edite aqui e reinicie a loja.
# O valor abaixo é curto de propósito: a loja se recusa a subir até você colocar o token gerado.
TIPITI_ADMIN_TOKEN=troque-isto

# --- Endereço público ------------------------------------------------------------------------------

# Domínio atendido pelo Caddy (HTTPS automático). O www.<domínio> redireciona para ele.
# Usado só pelo docker-compose; na versão systemd, edite o Caddyfile.servidor.
TIPITI_DOMINIO=tipiti.com.br

# Endereço do site usado nos links canônicos e no sitemap.xml (sem barra no final).
TIPITI_SITE_URL=https://tipiti.com.br

# E-mail de contato exibido na loja.
TIPITI_EMAIL=contato@tipiti.com.br

# WhatsApp inicial da loja: só dígitos, com 55 + DDD (ex.: 5592999999999).
# O número salvo no painel (Configurações) tem prioridade sobre este.
TIPITI_WHATSAPP=

# --- Servidor (só na versão systemd) -----------------------------------------------------------------
# No Docker estes valores são fixados pelo docker-compose.yml e o que estiver aqui é ignorado.

# Escute só no próprio servidor: quem fala com a internet é o Caddy.
TIPITI_HOST=127.0.0.1
TIPITI_PORT=8000

# Banco SQLite. As fotos enviadas pelo painel ficam na pasta "fotos" ao lado dele.
TIPITI_DB=/var/lib/tipiti/tipiti.db

# 1 = há um proxy reverso (Caddy) na frente: o IP do cliente vem do último valor de X-Forwarded-For.
# Use 1 SOMENTE se a porta da loja não for acessível diretamente pela internet.
TIPITI_TRUST_PROXY=1

# --- Backups (deploy/backup.sh) --------------------------------------------------------------------

# Pasta onde ficam os arquivos tipiti-AAAA-MM-DD-HHMM.tar.gz (no Docker é sempre /backups,
# que aparece no servidor como tipiti/deploy/backups).
TIPITI_BACKUP_DIR=/var/backups/tipiti

# Quantos backups manter (os mais antigos são apagados).
TIPITI_BACKUP_MANTER=14
